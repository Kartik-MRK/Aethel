# Aethel configuration.
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the tracked
# template, so it documents every setting without ever holding a value.
#
#   cp .env.example .env
#
# Every variable is optional. An unconfigured checkout runs: the Hub serves on
# 0.0.0.0:8000 with an open push endpoint, and the ops board reports the pieces
# that are not wired up rather than pretending they are. Nothing here needs to
# be set to demo the version-control core.
#
# A real shell variable always beats this file. `AETHEL_HUB_PORT=9000 python -m
# hub` binds 9000 no matter what is written below, so a one-off override never
# fights a checked-in default.


# -- Hub server ---------------------------------------------------------------

# Where the Hub keeps its object store, transparency log, and anchor records.
# Separate from any local `.aethel` repository: the Hub is a peer, not a
# working copy.
AETHEL_HUB_DATA=./hub-data

# Bind address. 0.0.0.0 lets a second machine reach the Hub over the LAN, which
# is how the two-laptop demo works. Set 127.0.0.1 to keep it on one machine.
AETHEL_HUB_HOST=0.0.0.0
AETHEL_HUB_PORT=8000

# Largest blob the Hub will accept, in bytes. A distilbert LoRA at rank 8 is
# about 0.6 MB, so 64 MiB is generous; the point of a ceiling is that one
# request cannot fill the disk.
AETHEL_HUB_MAX_BLOB=67108864

# Shared secret for write endpoints. Unset means an open Hub — correct for a
# laptop demo, and the ops board says so in plain words rather than implying a
# security it does not have. Set it and every push must send
# `Authorization: Bearer <token>`.
AETHEL_HUB_TOKEN=

# Set to any non-empty value to run uvicorn with auto-reload. Development only.
AETHEL_HUB_RELOAD=


# -- Client -------------------------------------------------------------------

# Default Hub for `aethel push`. `--remote` overrides it.
AETHEL_HUB_URL=http://localhost:8000

# Commit author. Falls back to the OS username.
AETHEL_AUTHOR=


# -- Chain (anchoring the transparency log) -----------------------------------
#
# A keyed provider endpoint, not a public one: public RPCs rate-limit under
# load, which on demo day means exactly while presenting. Never hard-code a
# network — Ropsten, Rinkeby, Kovan and Goerli have all been retired, and
# Sepolia will follow eventually.

AETHEL_CHAIN_RPC=
AETHEL_CHAIN_ID=11155111
AETHEL_ANCHOR_CONTRACT=

# Private key that signs anchor transactions, as 64 hex characters with no
# `0x`. Read only by the command-line anchoring tool — the Hub process never
# loads it, so the thing exposed to the internet holds no key that can spend.
#
# Use a throwaway wallet funded from a faucet with testnet ETH only. A key in a
# `.env` is a key on a laptop, and this one signs nothing worth stealing.
AETHEL_ANCHOR_KEY=

# For `forge verify-contract`. Unverified contracts render their events as raw
# hex on Etherscan, which looks broken on a projector.
AETHEL_ETHERSCAN_KEY=


# -- IPFS mirror --------------------------------------------------------------
#
# The mirror is an address, never a source of truth. Every fetch is checked
# against `blob_sha256` regardless of where the bytes came from, so a mirror
# that is missing, slow, or serving the wrong content cannot corrupt anything —
# it can only fail to help.

# Pinning API base. Credentials below are read by the client that pins, not by
# the Hub.
AETHEL_PINNING_ENDPOINT=https://api.pinata.cloud

# Pinata auth. The JWT covers the current API on its own; the key/secret pair
# is the older scheme, kept because some endpoints still take it.
AETHEL_PINATA_JWT=
AETHEL_PINATA_KEY=
AETHEL_PINATA_SECRET=

# Public gateway for "fetch this CID somewhere else" links. Any gateway serves
# any CID — that independence is the property worth showing, so which one is
# configured is a convenience, not a dependency.
AETHEL_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
